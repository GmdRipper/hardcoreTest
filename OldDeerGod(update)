spawn(function()
    getgenv().death = false
    local function a()
        while true do
            if (workspace.Ambience_Seek.Playing or workspace.Ambience_Figure.Playing or workspace.Ambience_FigureIntense.Playing or workspace.Ambience_FigureEnd.Playing or workspace.CurrentRooms:FindFirstChild("50")) then
                task.wait(5)
                continue
            end
            
            local cameraShaker = require(game.ReplicatedStorage.CameraShaker)
            local camera = workspace.CurrentCamera

            local camShake = cameraShaker.new(Enum.RenderPriority.Camera.Value, function(cf)
                camera.CFrame = camera.CFrame * cf
            end)
            camShake:Start()

            local Chase = Instance.new("Sound")
            Chase.SoundId = "rbxassetid://9114220463"
            Chase.Parent = workspace
            Chase.Volume = 0.7
            Chase.Looped = true
            Chase:Play()

            camShake:ShakeSustain(cameraShaker.Presets.Earthquake)

            local success, result = pcall(function()
                return game:GetObjects("rbxassetid://12262883448")
            end)

            if not success or not result or not result[1] then
                Chase:Destroy()
                camShake:StopSustained(5)
                return
            end

            local entity = result[1]
            entity.Parent = workspace
            local entityPart = entity:FindFirstChildWhichIsA("BasePart")

            if not entityPart then
                entity:Destroy()
                Chase:Destroy()
                camShake:StopSustained(5)
                return
            end

            local latestroom = game.ReplicatedStorage.GameData.LatestRoom.Value
            local gruh = workspace.CurrentRooms

            for i = latestroom, latestroom + 2 do
                if gruh:FindFirstChild(tostring(i)) then
                    local room = gruh[tostring(i)]
                    if room:FindFirstChild("Nodes") then
                        local nodes = room:FindFirstChild("Nodes")
                        for v = 1, #nodes:GetChildren() do
                            local waypoint = nodes:FindFirstChild(tostring(v))
                            if waypoint then
                                entityPart.CFrame = waypoint.CFrame + Vector3.new(0, 3.4, 0)
                                task.wait(0.05)
                            end
                        end
                    end
                end
            end

            camShake:StopSustained(5)
            game.TweenService:Create(Chase, TweenInfo.new(3), {Volume = 0}):Play()
            task.delay(3, function() Chase:Destroy() end)
            
            if getgenv().death == false then
                pcall(function()
                    getgenv().Title = "Last Chance To Look Away"
                    getgenv().Description = "Why are you running?"
                    getgenv().Reason = "Survive the rare Entity called Dear God"
                    getgenv().BadgeId = 2129311966
                    getgenv().Category = 10

                    local Unlock = require(game.Players.LocalPlayer.PlayerGui.MainUI.Initiator.Main_Lobby.RemoteListener.Modules.AchievementUnlock)
                    for _, v in pairs(require(game:GetService("ReplicatedStorage").Achievements)) do
                        v.Title = getgenv().Title
                        v.Desc = getgenv().Description
                        v.Reason = getgenv().Reason
                        v.BadgeId = getgenv().BadgeId
                        v.Category = getgenv().Category
                    end
                    Unlock(nil, "Join")
                end)
            end

            entity:Destroy()
            break
        end
    end
    a()
end)
